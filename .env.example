# ---------------------------------------------------------------------------
# External catalogue API (future production path)
# When PLANS_API_BASE_URL is set, sync + plan pages use the real API.
# JSON is compared/inserted into data/product-all-log.db — UI stays the same.
# ---------------------------------------------------------------------------
# Example: https://api.telecom.internal/api/v1
PLANS_API_BASE_URL=

# Prefer one auth style:
# 1) Bearer token
# PLANS_API_TOKEN=

# 2) Basic auth (username + password)
# PLANS_API_USERNAME=
# PLANS_API_PASSWORD=

# SQLite DB with product_offerings + audit_logs (auto sync compare).
# Default: data/product-all-log.db inside this project.
# PRODUCT_ALL_LOG_DB_PATH=C:\Users\canis\Desktop\web-project\kini-int-operation-portal\data\product-all-log.db
