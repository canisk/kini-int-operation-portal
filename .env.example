# ---------------------------------------------------------------------------
# External catalogue API (production)
# When PLANS_API_BASE_URL is set, sync + plan pages use the real API.
# ---------------------------------------------------------------------------
# Example: https://api.telecom.internal/api/v1
PLANS_API_BASE_URL=

# Prefer one auth style:
# 1) Bearer token
# PLANS_API_TOKEN=

# 2) Basic auth (username + password)
# PLANS_API_USERNAME=
# PLANS_API_PASSWORD=

# SQLite DB (Docker/NAS: mount ./data and point here)
# PRODUCT_ALL_LOG_DB_PATH=/app/data/product-all-log.db

# ---------------------------------------------------------------------------
# Portable sync: ONE job, many triggers → GET/POST /api/v1/sync/offerings
#   - Manual Refresh on /plans-portal/all-plans
#   - Vercel: vercel.json cron
#   - Docker/NAS: scripts/http-sync-scheduler.mjs (side process in entrypoint)
# ---------------------------------------------------------------------------

# Docker side-process scheduler (not Next instrumentation)
SYNC_SCHEDULER_ENABLED=true
SYNC_SCHEDULER_TZ=America/Toronto
SYNC_SCHEDULER_HOURS=9,13
# SYNC_SCHEDULER_BASE_URL=http://127.0.0.1:3000

# Optional: protect sync when Authorization header is present
# SYNC_API_SECRET=
# CRON_SECRET=

# Slack incoming webhook — alert when audit_logs get new INSERT/UPDATE rows
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Set true only if corp SSL inspection breaks Slack TLS (UNABLE_TO_VERIFY_LEAF_SIGNATURE)
# SLACK_TLS_INSECURE=true
